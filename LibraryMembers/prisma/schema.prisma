generator client {
  provider = "prisma-client"
  output   = "../generated"
  runtime = "deno"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LibraryMember {
  id     Int    @id @default(autoincrement())
  name   String
  member_id String
  email String? @unique
}